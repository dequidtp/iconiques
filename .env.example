# Copie ce fichier en `.env` puis remplace par tes vraies valeurs.
#   cp .env.example .env
# `.env` est ignoré par git (voir .gitignore) — tes clés ne seront pas commitées.
#
# Récupère-les dans Supabase → Project Settings → API :
#   Project URL   -> SUPABASE_URL
#   service_role  -> SUPABASE_SERVICE_KEY  (clé du scanner, ne JAMAIS l'exposer côté navigateur)

SUPABASE_URL=https://ton-projet.supabase.co
SUPABASE_SERVICE_KEY=ta-cle-service-role
